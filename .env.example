# Frontend API. Leave empty when frontend and API are reverse-proxied on the same origin.
VITE_API_URL=http://localhost:4000

# Backend
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amvatgram
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
OTP_HMAC_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
NATIONAL_CODE_HMAC_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_DAYS=30
OTP_MINUTES=5
OTP_MAX_ATTEMPTS=5
# console is development-only. Production must use a real provider integration.
OTP_DELIVERY=console

# Admin: create a hash with `npm run hash:password -- "your-strong-password"`
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Phase 4 payments: no fake success is allowed. Configure a real gateway adapter/bridge.
PAYMENT_WEBHOOK_SECRET=replace-with-long-random-secret
PAYMENT_GATEWAY_BASE_URL=https://your-payment-gateway.example/checkout
PAYMENT_RETURN_URL=http://localhost:3000/payment-return
